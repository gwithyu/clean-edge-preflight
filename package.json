{
  "name": "clean-edge-preflight",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only module dependency preflight for JavaScript and TypeScript projects",
  "bin": {
    "clean-edge": "./index.cjs"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "verify:package": "node scripts/check-package.cjs",
    "prepack": "node scripts/check-package.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "main": "./index.cjs",
  "files": [
    "index.cjs",
    "LICENSE",
    "README.md",
    "RELEASE_CHECKLIST.md",
    "RELEASE_NOTES.md",
    "SKILL.md",
    "VERIFICATION.md",
    "test/check.test.cjs",
    "scripts/check-package.cjs"
  ]
}
